# Copy to .env and adjust. Never commit .env.

# development | test | production
APP_ENV=development

# Switching to PostgreSQL is a change of this URL only.
DATABASE_URL=sqlite:///./wealthwise.db

# Required (min 32 chars). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Secure cookies are only sent over HTTPS. false is for local HTTP development only;
# the API refuses to start with APP_ENV=production and COOKIE_SECURE=false.
COOKIE_SECURE=false

# Cookie/header names (frontend/src/api.ts must use the same CSRF names).
ACCESS_COOKIE_NAME=ww_access
REFRESH_COOKIE_NAME=ww_refresh
CSRF_COOKIE_NAME=ww_csrf
CSRF_HEADER_NAME=X-CSRF-Token

# Upstox market prices (Module 6). Optional: without a token the API still starts and prices
# report "not_configured". Use an Upstox Analytics Token (read-only, valid for one year): Upstox
# Developer Apps -> Analytics -> Generate Token. Put the real token only in .env; never commit it.
UPSTOX_ANALYTICS_TOKEN=
# Price cache window in minutes (5-15).
MARKET_PRICE_TTL_MINUTES=10

# Frankfurter FX rates (Module 8). No API key exists or is needed. FX_ENABLED=false makes no requests
# (portfolio totals in a non-INR reporting currency then report the rate as unavailable).
FX_ENABLED=true
FRANKFURTER_BASE_URL=https://api.frankfurter.dev
# FX rate cache window in minutes (rates change at most daily).
FX_CACHE_TTL_MINUTES=60
